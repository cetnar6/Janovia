logs/
.claude/settings.local.json
*.pkg
__pycache__/

# zależności npm — do repozytorium trafia tylko gotowy plik js/lenis.min.js,
# bo strona jest statyczna i nie ma kroku budowania
node_modules/

# panel administratora

# dane dostępowe do bazy
admin/inc/config.php

# token Facebooka wygenerowany przy wdrożeniu z sekretu FB_TOKEN —
# powstaje na runnerze i na serwerze, nigdy w repozytorium
admin/inc/fb-token.php

# skład zatwierdzony w panelu trenera. W całości generowany przez panel
# i wykluczony z wysyłki, więc commit nic by nie dawał — za to łatwo byłoby
# wrzucić do repozytorium przypadkowe ustawienie z próbnego kliknięcia.
data/sklad.json

# przebieg meczu dopisywany na żywo w panelu trenera i wyniki spotkań
# rozegranych w panelu — ten sam powód co wyżej: pliki generuje panel
data/przebieg.json
data/wyniki.json
data/sklady.json

# baza SQLite — plik binarny z danymi lokalnymi
dane/

# uploads/ celowo NIE jest ignorowane: zdjęcia zawodników i aktualności
# są treścią strony i muszą trafić na GitHub Pages razem z resztą plików
