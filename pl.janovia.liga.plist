<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>pl.janovia.liga</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/karolcetnar/stronaJanovia/update_liga.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/karolcetnar/stronaJanovia</string>

    <!-- codziennie o 06:00; jeśli Mac spał, launchd uruchomi zadanie po wybudzeniu -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/karolcetnar/stronaJanovia/logs/update_liga.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/karolcetnar/stronaJanovia/logs/update_liga.log</string>
</dict>
</plist>
